#Database
POSTGRES_DB=tazama_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${TAZAMA_EXT_PG_PASSWORD:?set it in extensions/secrets.env}
POSTGRES_HOST=extensions-postgres
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:${TAZAMA_EXT_PG_PASSWORD:?set it in extensions/secrets.env}@extensions-postgres:5432/tazama_cms"
DWH_DATABASE_URL="postgresql://postgres:${TAZAMA_EXT_PG_PASSWORD:?set it in extensions/secrets.env}@extensions-postgres:5432/tazama_dwh"
#Alert Triage
AI_MODEL_ENDPOINT=http://10.10.80.16:8000/predict
TRIAGE_TYPE=MANUAL
CONFIDENCE_THRESHOLD=95
CLIENT_SYSTEM_INTERDICTION_ENABLED=true
SYSTEM_UUID=a9a8ff94-c7e4-4e6c-b421-e6d5d75a76e1
#Auth
TAZAMA_AUTH_URL=http://${SERVER_A_HOST}:3020/v1/auth
AUTH_PUBLIC_KEY_PATH=/auth/test-public-key.pem
CERT_PATH_PUBLIC=/auth/test-public-key.pem
KEYCLOAK_GROUP_NAME=tazama-cms

# Flowable Configuration
FLOWABLE_URL=http://flowable:8080/flowable-rest
FLOWABLE_USERNAME=rest-admin
FLOWABLE_PASSWORD=${TAZAMA_FLOWABLE_PASSWORD:?set it in extensions/secrets.env}

SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://extensions-postgres:5432/flowable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=${TAZAMA_EXT_PG_PASSWORD:?set it in extensions/secrets.env}

# NATS Server
SERVER_URL=nats://${SERVER_A_HOST}:14222
STARTUP_TYPE=nats
NODE_ENV=dev
FUNCTION_NAME=case-management-service
PORT=3090
AUDIT_PROVIDER=opensearch
PRODUCER_STREAM=default
CONSUMER_STREAM=investigation-service

# Performance
MAX_CPU=1

#SIDECAR_HOST=0.0.0.0:5000

# Redis (Server A Valkey - ⚠ no exterior port currently published from core; add 16379:6379 to core base.override if CMS Redis usage is confirmed active)
REDIS_HOST=${SERVER_A_HOST}
REDIS_PORT=16379
REDIS_PASSWORD=${TAZAMA_VALKEY_PASSWORD:?set it in extensions/secrets.env}
REDIS_DB=0

# Alert Priority
PRIORITY_FIRST_HALF=0.33
PRIORITY_SECOND_HALF=0.66
PRIORITY_THIRD_HALF=1.0
DEFAULT_SLA_HOURS=72
ALERT_PRIORITY_CRON_SCHEDULE="0 * * * *"

# Auto-assignment (disabled for MVP)
AUTO_ASSIGNMENT_ENABLED=false

# Email Service
# SMTP credentials come from TAZAMA_SMTP_USER / TAZAMA_SMTP_PASS in
# extensions/secrets.env (optional). When empty, the CMS backend starts fine but
# email sending is disabled (it logs a warning).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=${TAZAMA_SMTP_USER?set it in extensions/secrets.env (may be empty)}
SMTP_PASS=${TAZAMA_SMTP_PASS?set it in extensions/secrets.env (may be empty)}
MAIL_FROM=${TAZAMA_SMTP_USER?set it in extensions/secrets.env (may be empty)}

# Session & CORS (required by CMS backend; values below are for local plain-HTTP.
# For HTTPS use SESSION_COOKIE_SECURE=true, SESSION_COOKIE_SAMESITE=strict, and set
# CORS_ALLOWED_ORIGINS to the public frontend origin. CORS_ALLOWED_ORIGINS is the
# frontend origin, not the backend URL.)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5175

# CouchDB Configuration
# The CMS backend's account on the couchdb container (TAZAMA_COUCHDB_* in
# extensions/secrets.env; the couchdb service bootstraps its admin from the same keys).
COUCHDB_URL=http://couchdb:5984
COUCHDB_DATABASE=cms-evidence
COUCHDB_USERNAME=${TAZAMA_COUCHDB_USERNAME:?set it in extensions/secrets.env}
COUCHDB_PASSWORD=${TAZAMA_COUCHDB_PASSWORD:?set it in extensions/secrets.env}

# Visualization and Lakehouse
VOILA_URL=http://case-management-system-voila:8866
VOILA_BASE_URL=http://case-management-system-voila:8866
CMS_FRONTEND_ORIGIN=http://localhost:5175
GOLD_LAKEHOUSE_API_URL=http://${SERVER_C_HOST}:8282
GOLD_LAKEHOUSE_TIMEOUT=120000

# OpenSearch
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=${TAZAMA_OPENSEARCH_PASSWORD:?set it in extensions/secrets.env}
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false
OPENSEARCH_REFRESH=true

# Frontend Environment Variables:
# VITE_API_BASE_URL is set in docker-compose environment: sections so ${SERVER_B_HOST}
# substitution is applied correctly. env_file: does not expand shell variables.
VITE_APP_NAME="Tazama Case Management System"
VITE_APP_VERSION=0.0.1
VITE_CRYPTO_KEY=rCRrt08XYmYZrUoKffOQWXa327AJyBxv