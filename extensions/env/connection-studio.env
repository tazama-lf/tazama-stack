# Database Configuration (Server A)
POSTGRES_HOST=${SERVER_A_HOST}
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in extensions/secrets.env}
POSTGRES_DB=configuration

# Application Configuration
NODE_ENV=dev
MAX_CPU=2               
FUNCTION_NAME=connection-studio-backend

# Session Management
SESSION_TIMEOUT_MINUTES=30

# Tazama Authentication
TAZAMA_AUTH_URL=http://${SERVER_A_HOST}:3020/v1/auth
AUTH_PUBLIC_KEY_PATH=/auth/test-public-key.pem
CERT_PATH_PUBLIC=/auth/test-public-key.pem

# Database Configuration (used by Knex and app)
CONFIGURATION_DATABASE_URL=postgresql://postgres:${TAZAMA_CORE_PG_PASSWORD:?set it in extensions/secrets.env}@${SERVER_A_HOST}:15432/configuration
CONFIGURATION_DATABASE=configuration
CONFIGURATION_DATABASE_USER=postgres
CONFIGURATION_DATABASE_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in extensions/secrets.env}

ENCRYPTION_KEY=${TAZAMA_ENRICHMENT_ENCRYPTION_KEY:?set it in extensions/secrets.env}
IV_LENGTH=16

SERVER_URL=nats://${SERVER_A_HOST}:14222
STARTUP_TYPE=nats
PRODUCER_STREAM=config.notification
CONSUMER_STREAM=config.notification
STREAM_SUBJECT=config.notification

SFTP_HOST_CONSUMER=sftp
SFTP_PORT_CONSUMER=22
SFTP_USERNAME_CONSUMER=user
SFTP_PASSWORD_CONSUMER=${TAZAMA_TCS_SFTP_PASSWORD_ENCRYPTED:?set it in extensions/secrets.env}


SFTP_HOST_PRODUCER=sftp
SFTP_PORT_PRODUCER=22
SFTP_USERNAME_PRODUCER=user
SFTP_PASSWORD_PRODUCER=${TAZAMA_TCS_SFTP_PASSWORD_ENCRYPTED:?set it in extensions/secrets.env}

SMTP_HOST=smtp.gmail.com 
SMTP_PORT=587 
SMTP_SECURE=false 
# SMTP credentials come from TAZAMA_SMTP_USER / TAZAMA_SMTP_PASS in
# extensions/secrets.env (optional); empty = sending disabled.
SMTP_USER=${TAZAMA_SMTP_USER?set it in extensions/secrets.env (may be empty)}
SMTP_PASS=${TAZAMA_SMTP_PASS?set it in extensions/secrets.env (may be empty)}
SMTP_FROM_EMAIL=${TAZAMA_SMTP_USER?set it in extensions/secrets.env (may be empty)}
SMTP_FROM_NAME="Tazama Connection Studio" 

OPENSEARCH_USERNAME=admin 
OPENSEARCH_PASSWORD=${TAZAMA_OPENSEARCH_PASSWORD:?set it in extensions/secrets.env}
OPENSEARCH_NODE=http://opensearch:9200

ADMIN_SERVICE_URL=http://${SERVER_A_HOST}:3100
AUTH_URL=http://${SERVER_A_HOST}:8080

DEMS_URL=http://${SERVER_A_HOST}:${DEMS_PORT}
DEAPI_URL=http://${SERVER_A_HOST}:${DEAPI_PORT}
DEMS_STREAM=dems.notify

# Frontend Configuration
# VITE_API_BASE_URL and VITE_DATA_ENRICHMENT_SERVICE_URL are set in docker-compose
# environment: sections so ${SERVER_B_HOST} is properly substituted.
VITE_APP_TITLE="Tazama Connection Studio"
VITE_APP_ENV=production