
NODE_ENV=dev
MAX_CPU=2
FUNCTION_NAME=model-management-backend
PORT=3005
TAZAMA_AUTH_URL=http://${SERVER_A_HOST}:3020/v1/auth
AUTH_PUBLIC_KEY_PATH=/auth/test-public-key.pem
CERT_PATH_PUBLIC=/auth/test-public-key.pem
ADMIN_SERVICE_URL=http://${SERVER_A_HOST}:5100
ALLOWED_ORIGINS=http://${SERVER_B_HOST}:5174
CRYPTO_SECRET_KEY="rCRrt08XYmYZrUoKffOQWXa327AJyBxv"
ENCRYPTION_KEY="rCRrt08XYmYZrUoKffOQWXa327AJyBxv"
IV_LENGTH=12
AUDIT_PROVIDER=opensearch
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=admin 
OPENSEARCH_PASSWORD=${TAZAMA_OPENSEARCH_PASSWORD:?set it in extensions/secrets.env}
OPENSEARCH_INDEX=rule-studio-audit 

# Redis (backend queues + socket.io-redis adapter)
# Valkey runs in the core project (Server A / local core stack), published at 16379
# via core/docker-compose.base.override.yaml - not resolvable as 'valkey' from here.
REDIS_HOST=${SERVER_A_HOST}
REDIS_PORT=16379
REDIS_PASSWORD=${TAZAMA_VALKEY_PASSWORD:?set it in extensions/secrets.env}

# DockerHub credentials for simulation-studio
# (TAZAMA_DOCKERHUB_* in extensions/secrets.env).
DOCKERHUB_USERNAME=${TAZAMA_DOCKERHUB_USERNAME:?set it in extensions/secrets.env}
DOCKERHUB_TOKEN=${TAZAMA_DOCKERHUB_TOKEN:?set it in extensions/secrets.env}
DOCKERHUB_NAMESPACE=tazamaorg

# testcontainers - spawn ephemeral rule-executer containers for simulation.
# Ryuk is disabled because sim-studio runs Docker-in-Docker by design.
DOCKER_HOST=unix:///var/run/docker.sock
TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
TESTCONTAINERS_RYUK_DISABLED=true

# Frontend Configuration
# VITE URL vars are set in docker-compose environment: sections so ${SERVER_*_HOST}
# substitution is applied correctly. env_file: does not expand shell variables.
VITE_CRYPTO_KEY=rCRrt08XYmYZrUoKffOQWXa327AJyBxv
VITE_APP_NAME="Model Management"
VITE_APP_VERSION=0.0.1
