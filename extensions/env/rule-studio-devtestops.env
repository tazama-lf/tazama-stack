# SPDX-License-Identifier: Apache-2.0
#
# rule-studio-devtestops: creates and manages rule repositories in the GitHub
# organisation GITHUB_ORG_NAME and runs their tests. Every variable below
# must be non-empty, or the service refuses to start (it then restarts in a
# loop; the rest of the stack is unaffected). See README.md, section 8.5.

# NODE_ENV must stay "dev": "production" limits CORS to GET and breaks the
# rule-studio POST calls.
NODE_ENV=dev
FUNCTION_NAME=rule-studio-devtestops
HOST=0.0.0.0
PORT=3050
CERT_PATH_PUBLIC=/auth/test-public-key.pem

# GitHub
GITHUB_API_URL=https://api.github.com
# Organisation the rule repositories are created in. Set it to your own
# organisation; AWS deployments override it (infra/aws/scripts/helpers.ps1).
GITHUB_ORG_NAME=
# Template repository every new rule repository is created from
GITHUB_TEMPLATE_OWNER=tazama-lf
GITHUB_TEMPLATE_REPO=rule-studio-example
GITHUB_BRANCH=main
GITHUB_INIT_BRANCH=staging
GITHUB_TEST_REPORT_PATH=reports/unit-tests/latest/index.html

# The GitHub PAT, encrypted (aes-256-cbc, lowercase hex), and the key and IV
# to decrypt it with. The launcher derives GITHUB_TOKEN from
# TAZAMA_DEVTESTOPS_GITHUB_PAT.
ENCRYPTION_KEY=${TAZAMA_DEVTESTOPS_ENCRYPTION_KEY?set it in extensions/secrets.env (may be empty)}
ENCRYPTION_IV=${TAZAMA_DEVTESTOPS_ENCRYPTION_IV?set it in extensions/secrets.env (may be empty)}
GITHUB_TOKEN=${TAZAMA_DEVTESTOPS_GITHUB_TOKEN_ENCRYPTED?set it in extensions/secrets.env (may be empty)}
