# Tazama extensions credentials - TEMPLATE
#
# Copy this file to secrets.env in this folder and fill it in. secrets.env is
# gitignored; never commit it. The launchers and the documented docker compose
# commands load it with: --env-file .env --env-file secrets.env
# Background and rules: README.md (repository root), section 6.
# Server A needs this file too: DEMS and DEAPI run there from this folder.
#
# - [required] keys must have a value; compose stops with
#   "required variable ... is missing a value" when a compose file that uses
#   the key is part of the deployment and the key is empty.
# - [optional] keys may stay empty.
# - [generated] keys are derived from other keys. Leave them empty: the
#   launcher fills them in before every deployment of the extensions stack.
#   To set them by hand instead, see extensions/README.md, section
#   "Generating the SFTP values by hand".
# - MUST MATCH: the same key in the named secrets.env must hold the same value.
# - Values: no spaces, quotes or '$'. URL-embedded keys: only letters, digits
#   and - _ . ~ (the value is placed inside a connection URL as-is).
#   Exception: TAZAMA_SFTP_PASSWORD_HASH contains '$' and must be single-quoted.
# - Generate a random value:
#     bash:         openssl rand -hex 24
#     PowerShell 7: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# - Public test values for local development: extensions/README.md, section
#   "Original default values".

# [required] Password of the `postgres` user of extensions-postgres.
# Used by: extensions-postgres, the CMS (incl. its database URLs), Flowable.
# URL-embedded (CMS DATABASE_URL / DWH_DATABASE_URL).
# Applied only when the extensions-postgres volume is first initialised.
# MUST MATCH biar/secrets.env.
TAZAMA_EXT_PG_PASSWORD=

# [required] Password of the `postgres` user of core-postgres (Server A).
# Used by: connection-studio, DEAPI, DEMS. URL-embedded.
# MUST MATCH core/secrets.env.
TAZAMA_CORE_PG_PASSWORD=

# [required] Password of the core Valkey cache.
# Used by: DEAPI, DEMS, CMS, rule-studio (REDIS_PASSWORD).
# MUST MATCH core/secrets.env.
TAZAMA_VALKEY_PASSWORD=

# [required] Password of the pgAdmin default user (pgadmin4@pgadmin.org).
# Used by: extensions pgAdmin. Independent of the core pgAdmin password.
# Applied only when the pgAdmin volume is first initialised.
TAZAMA_PGADMIN_PASSWORD=

# [required] Password of the SFTP account `user`.
# No container reads it directly: the launcher derives
# TAZAMA_SFTP_PASSWORD_HASH and TAZAMA_TCS_SFTP_PASSWORD_ENCRYPTED below
# from it before every deployment of the extensions stack.
# At most 15 bytes: connection-studio currently decrypts longer values
# incorrectly. The launcher stops the deployment if it is longer.
TAZAMA_SFTP_PASSWORD=

# [generated] SHA-512 crypt hash of TAZAMA_SFTP_PASSWORD ($6$<salt>$<hash>).
# Used by: sftp (user definition user:<hash>:e:1001; the image logs that
# definition at startup, so its log shows only the hash).
# The launcher writes it in single quotes, or Compose would expand the '$'
# signs: TAZAMA_SFTP_PASSWORD_HASH='$6$...'
TAZAMA_SFTP_PASSWORD_HASH=

# [generated] TAZAMA_SFTP_PASSWORD encrypted with TAZAMA_ENRICHMENT_ENCRYPTION_KEY
# (aes-256-cbc, format <iv-hex>:<ciphertext-hex>).
# Used by: connection-studio (SFTP_PASSWORD_CONSUMER / _PRODUCER).
TAZAMA_TCS_SFTP_PASSWORD_ENCRYPTED=

# [required] Key connection-studio and DEAPI use to encrypt stored credentials.
# Used by: connection-studio, DEAPI (ENCRYPTION_KEY). Exactly 32 characters.
# Generate: openssl rand -hex 16
# Changing it makes credentials stored with the old key unreadable.
TAZAMA_ENRICHMENT_ENCRYPTION_KEY=

# [required] Password of the Flowable REST admin (`rest-admin`).
# Used by: flowable, CMS (FLOWABLE_PASSWORD).
TAZAMA_FLOWABLE_PASSWORD=

# [required] Password the CMS, connection-studio and rule-studio send to
# OpenSearch as `admin`. The bundled OpenSearch runs with its security plugin
# disabled, so it does not check this value.
TAZAMA_OPENSEARCH_PASSWORD=

# [required] CouchDB admin account (evidence store).
# Used by: couchdb (creates the admin at start), CMS.
# URL-embedded (biar unstructured pipeline).
# MUST MATCH biar/secrets.env.
TAZAMA_COUCHDB_USERNAME=
TAZAMA_COUCHDB_PASSWORD=

# [required] Secret CouchDB signs its session cookies with.
# Used by: couchdb (COUCHDB_SECRET).
# Generate: openssl rand -hex 32
TAZAMA_COUCHDB_COOKIE_SECRET=

# [required] Docker Hub account and personal access token simulation-studio
# logs in with.
# Used by: rule-studio backend (DOCKERHUB_USERNAME / DOCKERHUB_TOKEN).
TAZAMA_DOCKERHUB_USERNAME=
TAZAMA_DOCKERHUB_TOKEN=

# [optional] SMTP account for e-mail notifications. Empty = sending disabled.
# Used by: CMS, connection-studio.
TAZAMA_SMTP_USER=
TAZAMA_SMTP_PASS=

# [optional] Elastic APM secret token. Leave empty unless APM is enabled.
# Used by: DEAPI (APM_SECRET_TOKEN).
TAZAMA_APM_SECRET_TOKEN=
