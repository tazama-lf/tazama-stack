#
# Tazama core credentials - TEMPLATE
#
# Copy this file to secrets.env in this folder and fill it in. secrets.env is
# gitignored; never commit it. The launchers and the documented docker compose
# commands load it with: --env-file .env --env-file secrets.env
# Background and rules: README.md (repository root), section 6.
#
# - [required] keys must have a value; compose stops with
#   "required variable ... is missing a value" when a compose file that uses
#   the key is part of the deployment and the key is empty.
# - [optional] keys may stay empty.
# - MUST MATCH: the same key in the named secrets.env must hold the same value.
# - Values: no spaces, quotes or '$'. URL-embedded keys: only letters, digits
#   and - _ . ~ (the value is placed inside a connection URL as-is).
# - Generate a random value:
#     bash:         openssl rand -hex 24
#     PowerShell 7: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# - Public test values for local development: core/README.md, section
#   "Original default values".

# [required] Password of the `postgres` user of core-postgres.
# Used by: core-postgres, every core processor, the rules, Hasura.
# URL-embedded (Hasura connection URLs).
# Applied only when the core-postgres volume is first initialised.
# MUST MATCH extensions/secrets.env and biar/secrets.env.
TAZAMA_CORE_PG_PASSWORD=

# [required] Password of the Valkey cache (valkey --requirepass).
# Used by: valkey, every core processor that caches (REDIS_AUTH).
# MUST MATCH extensions/secrets.env.
TAZAMA_VALKEY_PASSWORD=

# [required] Password of the Keycloak bootstrap admin (`admin`).
# Used by: keycloak (Authentication addon).
# Applied only when the Keycloak database is first initialised.
TAZAMA_KEYCLOAK_ADMIN_PASSWORD=

# [required] Client secret auth-service uses against Keycloak.
# Used by: auth-service (Authentication addon).
# Must match the auth-lib-client secret in the imported realm
# (core/auth/keycloak/realms); the test realm uses the original default value.
TAZAMA_AUTH_CLIENT_SECRET=

# [required] Password of the Keycloak user relay-service-rest logs in as
# (AUTH_USERNAME in core/env/relay-service-rest.env).
# Used by: relay-service-rest. Must match that user's password in the realm.
TAZAMA_RELAY_AUTH_PASSWORD=

# [required] Secret of the Keycloak `jupyterhub` client; imported into the
# realm on the first Keycloak start.
# Used by: keycloak (Authentication addon).
# MUST MATCH biar/secrets.env.
TAZAMA_JUPYTERHUB_OIDC_CLIENT_SECRET=

# [required] Secret of the Keycloak `nifi` client; imported into the realm on
# the first Keycloak start.
# Used by: keycloak (Authentication addon).
# MUST MATCH biar/secrets.env.
TAZAMA_NIFI_OIDC_CLIENT_SECRET=

# [required] NextAuth session-signing secret of the Tazama demo UI.
# Used by: tazama-demo (Authentication addon).
# Generate: openssl rand -base64 32
TAZAMA_DEMO_NEXTAUTH_SECRET=

# [required] Hasura admin secret (console login and metadata API).
# Used by: hasura, hasura-init (Hasura addon).
TAZAMA_HASURA_ADMIN_SECRET=

# [required] Password of the pgAdmin default user (pgadmin4@pgadmin.org).
# Used by: core pgAdmin (pgAdmin addon). Prompted for only in server mode
# (PGADMIN_CONFIG_SERVER_MODE in core/env/core-pgadmin.env).
# Applied only when the pgAdmin volume is first initialised.
TAZAMA_PGADMIN_PASSWORD=

# [optional] Elastic APM secret token. Leave empty unless APM is enabled.
# Used by: every core processor (APM_SECRET_TOKEN), the APM utility stack.
TAZAMA_APM_SECRET_TOKEN=
