# SPDX-License-Identifier: Apache-2.0

# APP
FUNCTION_NAME=typology-processor
NODE_ENV=dev
MAX_CPU=1
SUPPRESS_ALERTS=true
SIDECAR_HOST=event-sidecar:${EVENT_SIDECAR_PORT}

# APM
APM_SERVICE_NAME=typology-processor
APM_URL=http://apm:8200
APM_SECRET_TOKEN=${TAZAMA_APM_SECRET_TOKEN?set it in core/secrets.env (may be empty)}
APM_ACTIVE=false

# REDIS
REDIS_DATABASE=0
REDIS_SERVERS=[{"host":"valkey", "port":6379}]
REDIS_AUTH=${TAZAMA_VALKEY_PASSWORD:?set it in core/secrets.env}
REDIS_IS_CLUSTER=false
DISTRIBUTED_CACHETTL=300
DISTRIBUTED_CACHE_ENABLED=false

# NODE CACHE
LOCAL_CACHETTL=300
LOCAL_CACHE_ENABLED=false

# POSTGRES
CONFIGURATION_DATABASE=configuration
CONFIGURATION_DATABASE_HOST=core-postgres
CONFIGURATION_DATABASE_PORT=
CONFIGURATION_DATABASE_USER=postgres
CONFIGURATION_DATABASE_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in core/secrets.env}
CONFIGURATION_DATABASE_CERT_PATH=

# LOGGER
LOG_LEVEL='info'

# NATS 
STARTUP_TYPE=nats
SERVER_URL=nats:4222
SERVICE_CHANNEL_CONSUMER=service-channel
SERVICE_CHANNEL_PRODUCER=service-channel-ack
SERVICE_CHANNEL_CLASS=typology-processor
SERVICE_CHANNEL_SOURCE_URI_PREFIX=

# Deferred to docker-compose.relay.yaml
INTERDICTION_DESTINATION=global
INTERDICTION_PRODUCER=interdiction-service