# SPDX-License-Identifier: Apache-2.0

# APP
FUNCTION_NAME=rule-901-rel-4-0-0
RULE_VERSION="4.0.0"
RULE_NAME="901"
NODE_ENV=dev
MAX_CPU=1
SUPPRESS_ALERTS=true
SIDECAR_HOST=event-sidecar:${EVENT_SIDECAR_PORT}

# APM
APM_URL=http://apm:8200
APM_SECRET_TOKEN=${TAZAMA_APM_SECRET_TOKEN?set it in core/secrets.env (may be empty)}
APM_ACTIVE=false
APM_SERVICE_NAME="rule-901"

# NODE CACHE
LOCAL_CACHETTL=300
LOCAL_CACHE_ENABLED=true

# POSTGRES
RAW_HISTORY_DATABASE=raw_history
RAW_HISTORY_DATABASE_HOST=core-postgres
RAW_HISTORY_DATABASE_PORT=
RAW_HISTORY_DATABASE_USER=postgres
RAW_HISTORY_DATABASE_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in core/secrets.env}
RAW_HISTORY_DATABASE_CERT_PATH=

CONFIGURATION_DATABASE=configuration
CONFIGURATION_DATABASE_HOST=core-postgres
CONFIGURATION_DATABASE_PORT=
CONFIGURATION_DATABASE_USER=postgres
CONFIGURATION_DATABASE_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in core/secrets.env}
CONFIGURATION_DATABASE_CERT_PATH=

EVENT_HISTORY_DATABASE=event_history
EVENT_HISTORY_DATABASE_HOST=core-postgres
EVENT_HISTORY_DATABASE_PORT=
EVENT_HISTORY_DATABASE_USER=postgres
EVENT_HISTORY_DATABASE_PASSWORD=${TAZAMA_CORE_PG_PASSWORD:?set it in core/secrets.env}
EVENT_HISTORY_DATABASE_CERT_PATH=

# LOGGER
LOG_LEVEL='info'

# NATS 
STARTUP_TYPE=nats
SERVER_URL=nats:4222
