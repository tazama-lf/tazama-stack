STARTUP_TYPE=nats
NODE_ENV=dev
MAX_CPU=1
SERVER_URL=nats:4222
OUTPUT_TO_JSON=false

DESTINATION_TRANSPORT_TYPE=${DESTINATION_TRANSPORT_TYPE:-@tazama-lf/nats-relay-plugin@4.1.0-rc.0}
DESTINATION_TRANSPORT_URL=${DESTINATION_TRANSPORT_URL:-nats:4222}
DESTINATION_NATS_AUTHENTICATED=${DESTINATION_NATS_AUTHENTICATED:-true}
DESTINATION_NATS_CERTIFICATE_AUTHORITY_PATH=${DESTINATION_NATS_CERTIFICATE_AUTHORITY_PATH:-/etc/nats/destination/ca.crt}
DESTINATION_NATS_CLIENT_CERT_PATH=${DESTINATION_NATS_CLIENT_CERT_PATH:-/etc/nats/destination/client.crt}
DESTINATION_NATS_CLIENT_KEY_PATH=${DESTINATION_NATS_CLIENT_KEY_PATH:-/etc/nats/destination/client.key}

APM_ACTIVE=false
APM_URL=http://apm:8200/
APM_SECRET_TOKEN=${TAZAMA_APM_SECRET_TOKEN?set it in core/secrets.env (may be empty)}

LOG_LEVEL='info'
SIDECAR_HOST=event-sidecar:${EVENT_SIDECAR_PORT}

# Deferred to docker-compose.relay.yaml

