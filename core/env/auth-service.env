# APP
FUNCTION_NAME=auth-service
NODE_ENV=dev
MAX_CPU=1

# Fastify
HOST=0.0.0.0
PORT=3020

# Auth lib
AUTH_PROVIDER=@tazama-lf/auth-lib-provider-keycloak
CERT_PATH_PRIVATE=test-private-key.pem #PKCS8 File
CERT_PATH_PUBLIC=test-public-key.pem

# Provider: @tazama-lf/auth-lib-provider-keycloak 
AUTH_URL=http://keycloak:8080
KEYCLOAK_REALM=tazama
CLIENT_SECRET=${TAZAMA_AUTH_CLIENT_SECRET:?set it in core/secrets.env}
CLIENT_ID=auth-lib-client

LOG_LEVEL='info'

# Auth lib
# AUTH_URL=http://keycloak:8080
# KEYCLOAK_REALM=tazama
# CERT_PATH_PRIVATE=test-private-key.pem #PKCS8 File
# CLIENT_SECRET=${TAZAMA_AUTH_CLIENT_SECRET}
