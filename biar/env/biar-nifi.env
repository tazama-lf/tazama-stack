PB_CONTEXT_NAME=Parameters
PB_NAME=pbucket
PB_BUCKET=tazama
PB_SENSITIVE_FALSE=false
# NiFi parameter values — Docker service names must be used here, not SERVER_C_HOST.
# All these services are in the same tazama-biar Docker project and reachable via
# the Docker bridge network.  Using the external EC2 hostname routes traffic through
# the EC2 ENI where the Security Group blocks ports 7619 and 9878 for self-referential
# traffic.  Docker service-name DNS bypasses the ENI entirely.
PB_HTTP_VALUE=http://biar-automation-orchestrator:7619/checksubmit
PB_HTTP_NAME=phttp
PB_OZONE_ENDPOINT=http://ozone-s3g:9878
PB_OZONE_NAME=pozone
# PostgreSQL hosts/ports for the NiFi DBCP pools (parameterized in tazama.xml).
# Core = the five Tazama core DBs; CMS = the tazama_cms DB.
CORE_PG_HOST=${SERVER_A_HOST}
CORE_PG_PORT=15432
CMS_PG_HOST=${SERVER_B_HOST}
CMS_PG_PORT=15433
PG_USER=postgres
# Must match the vendored POSTGRES_PASSWORD. Stored as a NiFi SENSITIVE
# parameter (encrypted; never returned by the REST API once set).
PG_PASSWORD=unused
# Ozone S3G credentials reused from S3A_ACCESS_KEY / S3A_SECRET_KEY in
# biar/.env; they are pushed into NiFi as sensitive parameters
# ozone_access_key / ozone_secret_key.

IMPORT_NIFI_TEMPLATE=true
NIFI_TEMPLATE_FILE=/nifi/tazama.xml
NIFI_TEMPLATE_TARGET_PG_ID=
NIFI_TEMPLATE_X=0.0
NIFI_TEMPLATE_Y=0.0
# After template instantiation: enable all controller services and start the
# flow (zero-touch import, per issue #190). Set to false to leave the flow
# stopped for manual start from the NiFi UI.
NIFI_AUTO_START=true

NIFI_WEB_HTTP_PORT=8088
NIFI_WEB_HTTP_HOST=0.0.0.0
NIFI_JVM_HEAP_INIT=512m
NIFI_JVM_HEAP_MAX=1g
