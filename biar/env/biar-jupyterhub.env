# --- Authentication (see tazama-lf/biar#184 / tazama-lf/tazama-stack#285) ---
# keycloak (default): OIDC login against the platform Keycloak realm.
# native: previous NativeAuthenticator signup/approval behaviour (no Keycloak needed).
JUPYTERHUB_AUTH=keycloak

# Keycloak realm issuer URL. Must be reachable BOTH by the user's browser (the
# authorize redirect) and by the jupyterhub container (token/userinfo calls),
# so use the externally visible Keycloak URL.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/tazama

# Externally visible JupyterHub URL; the OAuth callback is <url>/hub/oauth_callback
# and must be registered as a redirect URI on the Keycloak `jupyterhub` client.
JUPYTERHUB_PUBLIC_URL=http://localhost:8000

# Confidential Keycloak client (standard flow only).
KEYCLOAK_CLIENT_ID=jupyterhub
# Local default matches the test secret of the `jupyterhub` client in
# core/auth/keycloak/realms/00-tazama-test-realm.json.
# Override from your secret store at deploy time; never commit a real value.
# (AWS sandbox: SSM /tazama/creds/jupyterhub/oidc-client-secret)
KEYCLOAK_CLIENT_SECRET=jupyterhub-test-secret

# Encryption key for persisted auth state (required in keycloak mode).
# Generate with: openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=changeme

# JupyterHub admin account for native auth mode (first user to sign up must
# match this name). In keycloak mode admins come from the JUPYTER_ADMIN role.
JUPYTERHUB_ADMIN=admin

# Hudi warehouse path inside the container.
# Must match the container-side mount path defined in docker-compose.hub.biar.yaml:
#   volumes: - ${TAZAMA_WAREHOUSE_HOST_PATH}:/opt/Tazama_Warehouse:ro
# The previous value (/opt/Tazama_Hudi_warehouse) did not exist in the container.
WAREHOUSE_ROOT=/opt/Tazama_Warehouse

# Spark memory per user session
SPARK_DRIVER_MEMORY=4g
