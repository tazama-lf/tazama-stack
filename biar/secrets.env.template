#
# Tazama BIAR credentials - TEMPLATE
#
# Copy this file to secrets.env in this folder and fill it in. secrets.env is
# gitignored; never commit it. The launchers and the documented docker compose
# commands load it with: --env-file .env --env-file secrets.env
# Background and rules: README.md (repository root), section 6.
#
# - [required] keys must have a value; compose stops with
#   "required variable ... is missing a value" when a compose file that uses
#   the key is part of the deployment and the key is empty.
# - [optional] keys may stay empty.
# - MUST MATCH: the same key in the named secrets.env must hold the same value.
# - Values: no spaces, quotes or '$'. URL-embedded keys: only letters, digits
#   and - _ . ~ (the value is placed inside a connection URL as-is).
# - Generate a random value:
#     bash:         openssl rand -hex 24
#     PowerShell 7: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(24)).ToLower()
# - Public test values for local development: biar/README.md, section
#   "Original default values".

# [required] Ozone S3 gateway access key and secret key.
# Used by: automation-orchestrator, JupyterHub, ozone-aws-cli, and the NiFi
# AWS credentials service of a freshly imported flow (biar-nifi-init).
TAZAMA_S3_ACCESS_KEY=
TAZAMA_S3_SECRET_KEY=

# [required] Password of the `postgres` user of core-postgres (Server A).
# Set by biar-nifi-init on the NiFi database connection pools of a freshly
# imported flow. MUST MATCH core/secrets.env.
TAZAMA_CORE_PG_PASSWORD=

# [required] Password of the `postgres` user of extensions-postgres (Server B).
# Set by biar-nifi-init on the tazama_cms connection pool of a freshly imported
# flow. MUST MATCH extensions/secrets.env.
TAZAMA_EXT_PG_PASSWORD=

# [required] CouchDB account the unstructured pipeline uses (CMS evidence).
# Used by: biar-unstructured-pipeline (COUCHDB_URL). URL-embedded.
# MUST MATCH extensions/secrets.env.
TAZAMA_COUCHDB_USERNAME=
TAZAMA_COUCHDB_PASSWORD=

# [required] Secret of the Keycloak `jupyterhub` client.
# Used by: biar-jupyterhub (KEYCLOAK_CLIENT_SECRET).
# MUST MATCH core/secrets.env.
TAZAMA_JUPYTERHUB_OIDC_CLIENT_SECRET=

# [required] Key JupyterHub encrypts persisted auth state with.
# Used by: biar-jupyterhub (JUPYTERHUB_CRYPT_KEY).
# Generate: openssl rand -hex 32
TAZAMA_JUPYTERHUB_CRYPT_KEY=

# [optional] NiFi keycloak mode only (NIFI_AUTH=keycloak in biar/.env); NiFi
# refuses to start in that mode until all four are set.
# Secret of the Keycloak `nifi` client. MUST MATCH core/secrets.env.
TAZAMA_NIFI_OIDC_CLIENT_SECRET=
# Encrypts the passwords stored in the flow. At least 12 characters.
# Keep it once set: NiFi cannot read the stored passwords without it.
TAZAMA_NIFI_SENSITIVE_PROPS_KEY=
# Passwords of NiFi's server keystore and truststore.
TAZAMA_NIFI_KEYSTORE_PASSWORD=
TAZAMA_NIFI_TRUSTSTORE_PASSWORD=
