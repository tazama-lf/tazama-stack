# SPDX-License-Identifier: Apache-2.0

# Docker CLI settings
COMPOSE_BAKE=false

# Cross-server
SERVER_A_HOST=localhost
SERVER_B_HOST=localhost
SERVER_C_HOST=localhost

# --- Ports ---
TIKA_PORT=9998
SOLR_PORT=8983
NIFI_PORT=8088
OZONE_SCM_PORT=9876
OZONE_OM_PORT=9874
OZONE_RECON_PORT=9888
OZONE_S3G_PORT=9878
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
AUTOMATION_ORCHESTRATOR_PORT=7619
DATALAKEHOUSE_API_PORT=8282
JUPYTERHUB_PORT=8000

# --- NiFi authentication (see README section 9.5) ---
# none:     HTTP on NIFI_PORT, no login, bound to NIFI_BIND_ADDRESS (this machine only)
# keycloak: HTTPS on NIFI_HTTPS_PORT, Keycloak login; needs core Authentication
NIFI_AUTH=none
NIFI_BIND_ADDRESS=127.0.0.1
NIFI_HTTPS_PORT=8443
NIFI_WEB_PROXY_HOST=localhost:8443
NIFI_KEYCLOAK_ISSUER_URL=http://host.docker.internal:8080/realms/tazama
# Must match TAZAMA_NIFI_OIDC_CLIENT_SECRET of the Keycloak container (core)
TAZAMA_NIFI_OIDC_CLIENT_SECRET=nifi-test-secret
# Required in keycloak mode; NiFi will not start until they are set.
# Keep TAZAMA_NIFI_SENSITIVE_PROPS_KEY stable: it encrypts the passwords in the flow.
TAZAMA_NIFI_SENSITIVE_PROPS_KEY=
TAZAMA_NIFI_KEYSTORE_PASSWORD=
TAZAMA_NIFI_TRUSTSTORE_PASSWORD=

# --- Image version / branch ---
TAZAMA_VERSION=rc
BIAR_BRANCH=dev

# --- Warehouse ---
TAZAMA_WAREHOUSE_HOST_PATH=/opt/Warehouse

# --- Ozone / S3 ---
OZONE_REPLICATION_FACTOR=1
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=tazama
# Ozone S3G endpoint — use Docker service name so all project containers use the
# Docker bridge network rather than routing through the EC2 ENI (which would hit
# the SG: port 9878 has no inbound rule on Server C).
S3A_ENDPOINT=http://ozone-s3g:9878
S3A_ACCESS_KEY=tazama
S3A_SECRET_KEY=tazama
